# FranchiseOps AI - Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.

# Hugging Face
HF_TOKEN=
HUGGINGFACE_TOKEN=

# Kaggle (only if Kaggle API datasets are used)
KAGGLE_USERNAME=
KAGGLE_KEY=

# OTP / Gmail
# Use a dedicated project Gmail account and a Gmail App Password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Alternative email names supported by the application
EMAIL_ID=
EMAIL_PASSWORD=
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# JWT session signing
JWT_SECRET_KEY=

# Optional application data directory
FRANCHISEOPS_DATA_DIR=
